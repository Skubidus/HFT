@inherits LayoutComponentBase
@using SessionData

@inject SessionData _session;

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row bg-body border-0 px-4 border-bottom border-1">
            <div class="container-fluid px-0">
                <div class="row mx-0">
                    <div class="col p-0">
                        <h5 class="my-0 text-center">@_session.SelectedFinancialPlanName</h5>
                    </div>
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
